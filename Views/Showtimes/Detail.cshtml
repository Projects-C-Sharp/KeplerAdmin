@model admin_tickets.Models.ShowtimeDto
@{
    ViewData["Title"] = "Detalle función";
    var seats = ViewBag.Seats as List<admin_tickets.Models.SeatDto> ?? new();
    var statusClass = Model.Status switch {
        admin_tickets.Models.ShowtimeStatus.Active    => "badge-active",
        admin_tickets.Models.ShowtimeStatus.SoldOut   => "badge-soldout",
        admin_tickets.Models.ShowtimeStatus.Cancelled => "badge-inactive",
        _                                              => "badge-neutral"
    };
    var statusLabel = Model.Status switch {
        admin_tickets.Models.ShowtimeStatus.Active    => "Activa",
        admin_tickets.Models.ShowtimeStatus.SoldOut   => "Agotada",
        admin_tickets.Models.ShowtimeStatus.Cancelled => "Cancelada",
        admin_tickets.Models.ShowtimeStatus.Completed => "Completada",
        _                                              => Model.Status.ToString()
    };
    var sold      = seats.Count(s => s.Status == admin_tickets.Models.SeatStatus.Sold);
    var reserved  = seats.Count(s => s.Status == admin_tickets.Models.SeatStatus.Reserved);
    var available = seats.Count(s => s.Status == admin_tickets.Models.SeatStatus.Available);
    var occPct    = Model.TotalSeats > 0 ? (int)(sold * 100.0 / Model.TotalSeats) : 0;
    var rows      = seats.GroupBy(s => s.Row).OrderBy(g => g.Key).ToList();
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link">← Volver a funciones</a>
        <h1 class="page-title">@Model.EventName</h1>
        <p class="page-desc">
            @Model.StartTime.ToString("dddd, d 'de' MMMM yyyy HH:mm", new System.Globalization.CultureInfo("es-CO"))
            → @Model.EndTime.ToString("HH:mm")
        </p>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <span class="badge @statusClass" style="font-size:13px;padding:6px 14px">@statusLabel</span>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-secondary">Editar</a>
        @if (Model.Status == admin_tickets.Models.ShowtimeStatus.Active)
        {
            <form method="post" asp-action="SetStatus" asp-route-id="@Model.Id"
                  onsubmit="return confirm('¿Cancelar esta función?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="active" value="false"/>
                <button class="btn-secondary" style="border-color:rgba(255,0,110,.3);color:#ff6b9d">Cancelar función</button>
            </form>
        }
        else if (Model.Status == admin_tickets.Models.ShowtimeStatus.Cancelled)
        {
            <form method="post" asp-action="SetStatus" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="active" value="true"/>
                <button class="btn-primary">Activar función</button>
            </form>
        }
    </div>
</div>

<!-- KPI strip -->
<div class="kpi-grid" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));margin-bottom:24px">
    <div class="kpi-card kpi-primary">
        <div class="kpi-label">Precio base</div>
        <div class="kpi-value">$@Model.BasePrice.ToString("N0")</div>
        <div class="kpi-sub">COP por boleta</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Total asientos</div>
        <div class="kpi-value">@Model.TotalSeats</div>
        <div class="kpi-sub">en sala</div>
    </div>
    <div class="kpi-card kpi-accent">
        <div class="kpi-label">Vendidos</div>
        <div class="kpi-value">@sold</div>
        <div class="kpi-sub">@occPct% ocupación</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Reservados</div>
        <div class="kpi-value">@reserved</div>
        <div class="kpi-sub">pendientes de pago</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Disponibles</div>
        <div class="kpi-value">@available</div>
        <div class="kpi-sub">para la venta</div>
    </div>
</div>

<!-- Occupancy bar -->
<div class="card" style="margin-bottom:24px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <span class="card-title">Ocupación general</span>
        <span style="font-family:'Syne',sans-serif;font-weight:700;font-size:22px;color:var(--yellow)">@occPct%</span>
    </div>
    <div class="progress-bar" style="height:10px">
        <div class="progress-fill" style="width:@occPct%"></div>
    </div>
    <div style="display:flex;gap:20px;margin-top:12px;flex-wrap:wrap">
        <span style="font-size:12px;color:var(--text-dim)">
            <span style="display:inline-block;width:10px;height:10px;background:#FF006E;border-radius:2px;margin-right:4px;vertical-align:middle"></span>
            Vendidos (@sold)
        </span>
        <span style="font-size:12px;color:var(--text-dim)">
            <span style="display:inline-block;width:10px;height:10px;background:#5A00FF;border-radius:2px;margin-right:4px;vertical-align:middle"></span>
            Reservados (@reserved)
        </span>
        <span style="font-size:12px;color:var(--text-dim)">
            <span style="display:inline-block;width:10px;height:10px;background:rgba(90,0,255,.2);border-radius:2px;margin-right:4px;vertical-align:middle"></span>
            Disponibles (@available)
        </span>
    </div>
</div>

<!-- Seat map -->
@if (seats.Any())
{
    <div class="card">
        <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <h2 class="card-title">Mapa de asientos</h2>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <span class="badge" style="background:rgba(245,255,0,.1);color:var(--yellow);border:1px solid rgba(245,255,0,.25)">Disponible</span>
                <span class="badge" style="background:rgba(90,0,255,.2);color:#a78bfa;border:1px solid rgba(90,0,255,.35)">Reservado</span>
                <span class="badge" style="background:rgba(255,0,110,.15);color:#ff6b9d;border:1px solid rgba(255,0,110,.25)">Vendido</span>
            </div>
        </div>

        <div class="seat-map-wrap">
            <!-- Stage indicator -->
            <div class="stage-bar">ESCENARIO</div>

            @foreach (var row in rows)
            {
                <div class="seat-row">
                    <span class="row-label">@row.Key</span>
                    <div class="seat-cells">
                        @foreach (var seat in row.OrderBy(s => s.Number))
                        {
                            var cls = seat.Status switch {
                                admin_tickets.Models.SeatStatus.Sold     => "seat-sold",
                                admin_tickets.Models.SeatStatus.Reserved => "seat-reserved",
                                _                                          => "seat-available"
                            };
                            var typeMark = seat.Type switch {
                                admin_tickets.Models.SeatType.VIP     => "V",
                                admin_tickets.Models.SeatType.Premium => "P",
                                _                                      => ""
                            };
                            <div class="seat @cls" title="@seat.Label — @seat.Type — @seat.Status">
                                @typeMark
                            </div>
                        }
                    </div>
                    <span class="row-label">@row.Key</span>
                </div>
            }
        </div>

        <!-- Type legend -->
        <div style="display:flex;gap:16px;margin-top:16px;flex-wrap:wrap">
            <span style="font-size:12px;color:var(--text-dim)">Sin letra = Standard</span>
            <span style="font-size:12px;color:var(--text-dim)"><strong style="color:#a78bfa">P</strong> = Premium</span>
            <span style="font-size:12px;color:var(--text-dim)"><strong style="color:var(--yellow)">V</strong> = VIP</span>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align:center;padding:40px;color:var(--text-dim)">
        <div style="font-size:36px;margin-bottom:12px;opacity:.3">◫</div>
        <p>No hay asientos registrados para esta función.</p>
    </div>
}

<style>
.seat-map-wrap { overflow-x: auto; padding: 8px 0; }
.stage-bar {
  text-align: center; font-size: 10px; letter-spacing: .2em;
  color: var(--text-dim); border: 1px solid var(--border);
  border-radius: 4px; padding: 6px; margin-bottom: 20px;
  background: var(--surface2);
}
.seat-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; min-width: max-content; }
.row-label {
  width: 22px; text-align: center; font-family: 'Syne', sans-serif;
  font-size: 11px; font-weight: 700; color: var(--text-dim); flex-shrink: 0;
}
.seat-cells { display: flex; gap: 4px; }
.seat {
  width: 26px; height: 26px; border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700; cursor: default;
  transition: transform .15s; border: 1px solid transparent;
}
.seat:hover { transform: scale(1.2); z-index: 1; position: relative; }
.seat-available { background: rgba(245,255,0,.1); border-color: rgba(245,255,0,.3); color: var(--yellow); }
.seat-reserved  { background: rgba(90,0,255,.2);  border-color: rgba(90,0,255,.4);  color: #a78bfa; }
.seat-sold      { background: rgba(255,0,110,.15); border-color: rgba(255,0,110,.3); color: #ff6b9d; }
@@media(max-width:480px){.seat{width:20px;height:20px;font-size:8px;border-radius:3px}}
</style>
